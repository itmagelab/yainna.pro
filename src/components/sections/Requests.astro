---
import SectionHeader from '../ui/SectionHeader.astro';
import Reveal from '../ui/Reveal.astro';
import type { z } from 'astro/zod';
import type { sectionSchema } from '../../schemas/sections';

type Data = Extract<z.infer<typeof sectionSchema>, { kind: 'requests' }>;

interface Props {
  data: Data;
}

const { data } = Astro.props;
const titleId = 'requests-title';
---

<section id={data.anchor} class="section border-t border-cream-300" aria-labelledby={titleId}>
  <div class="page">
    <Reveal>
      <SectionHeader
        eyebrow={data.eyebrow}
        title={data.title}
        intro={data.intro}
        id={titleId}
        class="max-w-[46rem]"
      />
    </Reveal>

    <ul class="mt-12 grid gap-x-12 sm:grid-cols-2">
      {data.items.map((item, index) => (
        <Reveal
          as="li"
          class="flex h-full flex-col border-t border-cream-300 py-6 sm:py-7"
          delay={(index % 2) * 60}
        >
          {item.tag && <p class="text-tiny font-medium text-clay-700">{item.tag}</p>}
          <p class="mt-2 font-display text-h4 text-balance text-ink-900">{item.phrase}</p>
          {item.note && <p class="mt-3 text-small text-ink-500">{item.note}</p>}
        </Reveal>
      ))}
    </ul>
  </div>
</section>
